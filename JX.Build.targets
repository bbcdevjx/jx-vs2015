<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="JXCopyBuildOutputs" AfterTargets="Build">
    <ItemGroup>
      <_JXBinaryOutput Include="$(TargetPath)"
                       Condition="'$(TargetExt)' == '.exe' Or '$(TargetExt)' == '.dll'" />
      <_JXLibraryOutput Include="$(TargetPath)"
                        Condition="'$(TargetExt)' == '.lib'" />
      <_JXLibraryOutput Include="$(ImportLibrary)"
                        Condition="'$(TargetExt)' == '.dll' And Exists('$(ImportLibrary)')" />
    </ItemGroup>

    <MakeDir Directories="$(JXBinaryOutputDir)"
             Condition="'@(_JXBinaryOutput)' != ''" />
    <MakeDir Directories="$(JXLibraryOutputDir)"
             Condition="'@(_JXLibraryOutput)' != ''" />

    <Copy SourceFiles="@(_JXBinaryOutput)"
          DestinationFolder="$(JXBinaryOutputDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_JXBinaryOutput)' != ''" />
    <Copy SourceFiles="@(_JXLibraryOutput)"
          DestinationFolder="$(JXLibraryOutputDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_JXLibraryOutput)' != ''" />
  </Target>
</Project>
